# Copy to .env for local backend development. Replace every placeholder.
# Never commit the real .env file.

MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=smoothscar_dev

# Admin access: use a long, randomly generated secret; rotate any prior value.
ADMIN_PASSCODE=REPLACE_WITH_LONG_RANDOM_SECRET

# Transactional email configuration currently consumed by the Emergent relay.
# These are temporary migration variables, not a standalone Resend integration.
EMERGENT_EMAIL_KEY=REPLACE_WITH_PROVIDER_KEY
EMAIL_FROM_NAME=SmoothScar
EMAIL_REPLY_TO=
ADMIN_EMAIL=admin@example.com
CONTACT_EMAIL=support@example.com
SITE_URL=http://localhost:3000

# Push integration currently depends on the Emergent relay.
EMERGENT_PUSH_KEY=REPLACE_WITH_PROVIDER_KEY

# Photo storage currently depends on Emergent-managed object storage.
EMERGENT_LLM_KEY=REPLACE_WITH_PROVIDER_KEY
INTEGRATION_PROXY_URL=

# Apple sign-in audience(s); configure the real app identifiers before launch.
APPLE_AUDIENCES=REPLACE_WITH_APPLE_BUNDLE_IDENTIFIER

# Frontend setting is configured separately in frontend/.env:
# EXPO_PUBLIC_BACKEND_URL=http://127.0.0.1:8001
